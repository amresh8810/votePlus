# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
dist/
build/
.vercel/
.vite/
.cache/
*.local

# Environment files (NEVER commit real secrets)
.env
.env.*
!.env.example
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.code-workspace

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test coverage
coverage/

# ── Go / Backend ──────────────────────────────────────────────────────────────
# Compiled binaries
backend/*.exe
backend/*.exe~
backend/server
backend/main

# Build output directory (if added later)
backend/bin/

# Go test & coverage artifacts
*.test
*.out
coverage.html

# Go module download cache (don't commit vendor unless intentional)
# vendor/

# Air (live reload tool) tmp dir
backend/tmp/

# ── General ──────────────────────────────────────────────────────────────────
*.log
*.pid
*.seed
*.pid.lock

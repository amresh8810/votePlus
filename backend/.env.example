# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
APP_ENV=development          # development | production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allowed origin for Cross-Origin Resource Sharing.
# Set to your React frontend URL in development (e.g. http://localhost:5173).
ALLOWED_ORIGIN=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Connection string and database name
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=live_polling
SKIP_DB=true

# ── Redis Realtime Cache & Pub/Sub ───────────────────────────────────────────
# Local: localhost:6379
# Cloud: redis://<user>:<password>@<host>:<port>
REDIS_URL=localhost:6379
REDIS_PASSWORD=              # leave empty for no-auth local Redis
REDIS_DB=0
SKIP_REDIS=true

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong random secret for production, e.g.:
#   openssl rand -hex 32
JWT_SECRET=change_me_in_production_super_secret_key_32bytes
JWT_EXPIRATION=24h

# Password reset testing only. Keep false in production unless token exposure is intentional.
EXPOSE_RESET_TOKEN=false
